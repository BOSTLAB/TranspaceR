library(TranspaceR)
path = '~/Spatial_atlas/Datasets/Xenium/Lymph_node/'
Output_path = "~/Spatial_atlas/Picture_pipeline/Xenium/Lymph_node/"
Method = "Xenium"
Tissue = "Lymph_node"
#-------------------------------------------------------------------------------------------------------
# Data loading
Expression_file = read.csv(paste(path, "Xenium_Lymph_node_ExprMat.csv", sep = ""), header = TRUE)
Meta_data = read.csv(paste(path,"Xenium_Lymph_node_Metadata.csv",sep =""), header = TRUE)
# Delete unfit gene columns
Expression_file <- subset(Expression_file, select = -last)
# From here, Expression_file should be numeric
Expression_file = Expression_file[,-c(1,2,3)]
Meta_data = Compute_radius(Meta_data,Method)
QC1_results =  QC_RNA_size_threshold(Expression_file,Meta_data,Method,Tissue,Output_path)
roxygen2::roxygenise('~/Music/TranspaceR')
